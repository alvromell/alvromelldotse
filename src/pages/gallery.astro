---
import Album from "@components/Album.astro";
import { sanityClient } from "sanity:client";
import BaseLayout from "src/layouts/BaseLayout.astro";

const content = await sanityClient.fetch(
    `*[_type == "album"]{
        title,
        description,
        date,
        coverImage{
            asset->{url},
            alt
        }
    }`,
) as {
    title: string;
    description: string;
    date: string;
    coverImage: { asset: { url: string }; alt: string };
}[];
---
<BaseLayout title={content[0]?.title ?? 'Random gallery'}>
   <h1 class="mt-20">{content[0]?.title ?? 'Nothing'}</h1>
   <p>{content[0]?.description ?? 'Nothing'}</p>
   <div class="coverImage">
      <img src={content[0].coverImage.asset.url} alt={content[0].coverImage.alt ?? content[0].title} />
   </div>
</BaseLayout>
